# ---- 推理上游 ----
# 默认 ChatFire 公共 API；自托管或其他 OpenAI 兼容网关改这里
UPSTREAM=https://api.chatfire.site
# 浏览器侧基地址：留空 = 同源（推荐，走 nginx 反代规避 CORS）
API_BASE_URL=

# ---- 画布存储服务（apps/server，SQLite）----
# compose 内固定 http://server:16812；仅前后分离部署时改
CANVAS_SERVER=http://server:16812

# ---- 前端开发（apps/web/.env）----
# VITE_API_BASE_URL=
# VITE_UPSTREAM=https://api.chatfire.site
# VITE_CANVAS_SERVER=http://localhost:16812
