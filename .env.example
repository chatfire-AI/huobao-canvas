# ---- 推理上游 ----
# 默认 ChatFire 公共 API；自托管或其他 OpenAI 兼容网关改这里
UPSTREAM=https://api.chatfire.site
# 浏览器侧基地址：留空 = 同源（推荐，走 nginx 反代规避 CORS）
API_BASE_URL=

# ---- 可选媒体存储（docker compose --profile storage up -d）----
STORAGE_PROVIDER=none
STORAGE_UPLOAD_URL=/storage/upload
STORAGE_PUBLIC_BASE=http://localhost:8080/storage
EXPIRE_DAYS=7

# ---- 前端开发（apps/web/.env）----
# VITE_API_BASE_URL=
# VITE_UPSTREAM=https://api.chatfire.site
# VITE_STORAGE_PROVIDER=none
# VITE_STORAGE_UPLOAD_URL=/storage/upload
