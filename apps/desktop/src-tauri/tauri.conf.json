{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "火宝画布",
  "version": "2.0.0",
  "identifier": "site.chatfire.canvas",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "PORT=1420 pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "火宝画布",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
